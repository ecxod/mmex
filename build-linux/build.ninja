  DEFINES = -DCODEC_TYPE=CODEC_TYPE_AES128 -DHAVE_ACOSH -DHAVE_ASINH -DHAVE_ATANH -DHAVE_ISBLANK -DNOPCH -DSQLITE_CORE -DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_ENABLE_EXTFUNC -DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_JSON1 -DSQLITE_HAS_CODEC -DWXSQLITE3_USE_SQLCIPHER_LEGACY
