# =============================================================================
# Object build statements for STATIC_LIBRARY target fmt


#############################################
# Order-only phony target for fmt

build cmake_object_order_depends_target_fmt: phony || .

build 3rd/fmt/CMakeFiles/fmt.dir/src/format.cc.o: CXX_COMPILER__fmt_unscanned_Release /root/mmex/3rd/fmt/src/format.cc || cmake_object_order_depends_target_fmt
  DEP_FILE = 3rd/fmt/CMakeFiles/fmt.dir/src/format.cc.o.d
  FLAGS = -O3 -DNDEBUG -std=gnu++17
  INCLUDES = -I/root/mmex/3rd/fmt/include
  OBJECT_DIR = 3rd/fmt/CMakeFiles/fmt.dir
  OBJECT_FILE_DIR = 3rd/fmt/CMakeFiles/fmt.dir/src

build 3rd/fmt/CMakeFiles/fmt.dir/src/os.cc.o: CXX_COMPILER__fmt_unscanned_Release /root/mmex/3rd/fmt/src/os.cc || cmake_object_order_depends_target_fmt
  DEP_FILE = 3rd/fmt/CMakeFiles/fmt.dir/src/os.cc.o.d
  FLAGS = -O3 -DNDEBUG -std=gnu++17
  INCLUDES = -I/root/mmex/3rd/fmt/include
  OBJECT_DIR = 3rd/fmt/CMakeFiles/fmt.dir
  OBJECT_FILE_DIR = 3rd/fmt/CMakeFiles/fmt.dir/src


# =============================================================================
# Link build statements for STATIC_LIBRARY target fmt


#############################################
# Link the static library 3rd/fmt/libfmt.a

build 3rd/fmt/libfmt.a: CXX_STATIC_LIBRARY_LINKER__fmt_Release 3rd/fmt/CMakeFiles/fmt.dir/src/format.cc.o 3rd/fmt/CMakeFiles/fmt.dir/src/os.cc.o
  LANGUAGE_COMPILE_FLAGS = -O3 -DNDEBUG
  OBJECT_DIR = 3rd/fmt/CMakeFiles/fmt.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = 3rd/fmt/libfmt.a
  TARGET_PDB = fmt.a.dbg


#############################################
# Utility command for package

build 3rd/fmt/CMakeFiles/package.util: CUSTOM_COMMAND 3rd/fmt/all
  COMMAND = cd /root/mmex/build-linux && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build 3rd/fmt/package: phony 3rd/fmt/CMakeFiles/package.util


#############################################
# Utility command for package_source

build 3rd/fmt/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /root/mmex/build-linux && /usr/bin/cpack --config ./CPackSourceConfig.cmake /root/mmex/build-linux/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build 3rd/fmt/package_source: phony 3rd/fmt/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build 3rd/fmt/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /root/mmex/build-linux/3rd/fmt && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build 3rd/fmt/edit_cache: phony 3rd/fmt/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build 3rd/fmt/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /root/mmex/build-linux/3rd/fmt && /usr/bin/cmake --regenerate-during-build -S/root/mmex -B/root/mmex/build-linux
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build 3rd/fmt/rebuild_cache: phony 3rd/fmt/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build 3rd/fmt/list_install_components: phony


#############################################
# Utility command for install

build 3rd/fmt/CMakeFiles/install.util: CUSTOM_COMMAND 3rd/fmt/all
  COMMAND = cd /root/mmex/build-linux/3rd/fmt && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build 3rd/fmt/install: phony 3rd/fmt/CMakeFiles/install.util


#############################################
# Utility command for install/local

build 3rd/fmt/CMakeFiles/install/local.util: CUSTOM_COMMAND 3rd/fmt/all
  COMMAND = cd /root/mmex/build-linux/3rd/fmt && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build 3rd/fmt/install/local: phony 3rd/fmt/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build 3rd/fmt/CMakeFiles/install/strip.util: CUSTOM_COMMAND 3rd/fmt/all
  COMMAND = cd /root/mmex/build-linux/3rd/fmt && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build 3rd/fmt/install/strip: phony 3rd/fmt/CMakeFiles/install/strip.util

